#compdef tock
# zsh completion for tock. Install as _tock in a directory on $fpath.

_tock_clock() {
  local -a modes durations
  modes=('stopwatch:count up from zero instead of down')
  durations=(
    '5m:five minutes'
    '10m:ten minutes'
    '15m:fifteen minutes'
    '25m:a pomodoro'
    '45m:forty-five minutes'
    '1h:an hour'
    '1h30m:an hour and a half'
    '90s:ninety seconds'
    '10\:00:ten minutes as mm\:ss'
  )
  _describe -t modes mode modes
  _describe -t durations 'duration (25m, 1h30m, 90s, 10:00)' durations
}

# -t and -u may come before every clock, so neither excludes itself.
_arguments -s -S \
  '*'{-t+,--title=}'[label the clock that follows]:title: ' \
  '*'{-u,--up}'[add a stopwatch]' \
  '--no-bell[flash at zero without ringing the terminal bell]' \
  '(- *)'{-h,--help}'[print help]' \
  '(- *)'{-V,--version}'[print the version]' \
  '*:duration or stopwatch:_tock_clock'
